# This file is optional. docker compose up --build works without a .env file,
# because every setting below has the default shown here (see docker-compose.yaml).
# To change a setting, copy this file to .env, remove the # in front of the line and
# change the value. Keep .env out of Git with a line in .gitignore.
# Docker Compose reads .env from the folder that holds docker-compose.yaml.

# The database. The password protects only the database inside this Compose project.
# POSTGRES_USER=credit
# POSTGRES_DB=credit
# POSTGRES_PASSWORD=credit

# The Model B checkpoint and the revision it is pinned to.
# MODEL_B_CHECKPOINT=impira/layoutlm-document-qa
# MODEL_B_REVISION=beed3c4d02d86017ebca5bd0fdf210046b907aa6

# The Ollama tag of Model C. The ollama-pull service downloads it.
# MODEL_C=llama3.2:3b

# The URL of the database. If not set, it is built from the three database values above.
# Its form is postgresql+psycopg://USER:PASSWORD@HOST:5432/DB. Inside Compose, HOST is
# the name of the service, postgres.
# DATABASE_URL=

# The registered Model A. Left empty, the backend scores with the baseline.
# WANDB_API_KEY is a secret: put it only in .env, never in this file, and never commit .env.
# MODEL_A=
# WANDB_API_KEY=
