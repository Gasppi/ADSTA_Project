# Copy this file to .env and fill in the values. Keep .env out of Git with a line in .gitignore.
# Docker Compose reads .env from the folder that holds docker-compose.yaml.

POSTGRES_USER=credit
POSTGRES_DB=credit
POSTGRES_PASSWORD=

# the Model B you chose, and the revision you pinned it to.
MODEL_B_CHECKPOINT=
MODEL_B_REVISION=

# the Ollama tag of the Model C you chose.
MODEL_C=

# the URL of your database. Its form is postgresql+psycopg://USER:PASSWORD@HOST:5432/DB.
# Inside Compose, HOST is the name of the service, postgres.
DATABASE_URL=

# The registered Model A. Left empty, the backend scores with your baseline.
MODEL_A=
WANDB_API_KEY=
